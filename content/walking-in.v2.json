  "teaching_notes": [
    {
      "id": "reservation-note",
      "before_exercise": "choose-booking",
      "text": {
        "ca": "«Tinc reserva» i «Tinc una taula reservada» comuniquen que has reservat. Pots ser breu o formal.",
        "en": "“Tinc reserva” and “Tinc una taula reservada” both communicate a booking. Short or formal wording is fine."
      }
    },
    {
      "id": "party-size-note",
      "before_exercise": "type-table",
      "text": {
        "ca": "«Teniu lloc?» pregunta si hi ha espai. «Som dos» diu quantes persones sou: dos, tres, quatre.",
        "en": "“Teniu lloc?” asks about space. “Som dos” says your party size: two, three, four."
      }
    },
    {
      "id": "recovery-note",
      "before_exercise": "choose-repeat",
      "text": {
        "ca": "Si no ho entens, pots demanar que ho repeteixin. És part de la conversa.",
        "en": "If you miss something, you can ask for repetition. That is part of communicating."
      }
    },
    {
      "id": "late-note",
      "before_exercise": "build-late",
      "text": {
        "ca": "«Perdó» pot reconèixer el retard. Després pregunta si encara teniu taula.",
        "en": "“Perdó” can acknowledge being late. Then ask whether you still have a table."
      }
    },
    {
      "id": "closing-note",
      "before_exercise": "speak-arrival",
      "text": {
        "ca": "«Passeu» et convida a entrar. Pots respondre «D’acord, gràcies».",
        "en": "“Passeu” invites you to come in. You can answer “D’acord, gràcies”."
      }
    }
  ],
